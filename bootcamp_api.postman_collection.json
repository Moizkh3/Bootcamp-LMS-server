    {
      "name": "Progress",
      "description": "Student daily Agile standup reporting.",
      "item": [
        {
          "name": "Submit Progress",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"yesterdayWork\": \"I completed the user authentication APIs.\",\n    \"todayPlan\": \"I will work on the assignment submission and progress modules.\",\n    \"blockers\": \"None for now.\",\n    \"githubLink\": \"https://github.com/example/repo\",\n    \"hoursWorked\": 6\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/progress/submit",
              "host": ["{{base_url}}"],
              "path": ["progress", "submit"]
            }
          }
        },
        {
          "name": "Update Progress",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"yesterdayWork\": \"I completed the user authentication APIs (Updated).\",\n    \"todayPlan\": \"I will work on the assignment submission and progress modules (Updated).\",\n    \"blockers\": \"I am stuck on a multer deployment bug.\",\n    \"githubLink\": \"https://github.com/example/repo-v2\",\n    \"hoursWorked\": 8\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/progress/update/:id",
              "host": ["{{base_url}}"],
              "path": ["progress", "update", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Get Student Progress",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/progress/my-progress",
              "host": ["{{base_url}}"],
              "path": ["progress", "my-progress"]
            }
          }
        },
        {
          "name": "Get Bootcamp Progress",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/progress/bootcamp/:bootcampId",
              "host": ["{{base_url}}"],
              "path": ["progress", "bootcamp", ":bootcampId"],
              "variable": [
                {
                  "key": "bootcampId",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ]
