              "host": ["{{base_url}}"],
              "path": ["submission", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "<submission_object_id>",
                  "description": "MongoDB ObjectId of the submission"
                }
              ]
            }
          }
        },
        {
          "name": "Update Submission",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "note",
                  "value": "Updated note",
                  "type": "text"
                },
                {
                  "key": "referenceFile",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/submission/:id",
              "host": ["{{base_url}}"],
              "path": ["submission", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "<submission_object_id>",
                  "description": "MongoDB ObjectId of the submission"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Submission",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/submission/:id",
              "host": ["{{base_url}}"],
              "path": ["submission", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "<submission_object_id>",
                  "description": "MongoDB ObjectId of the submission"
                }
              ]
            }
          }
        }
      ]
    },
    {
