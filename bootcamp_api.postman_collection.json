{
  "info": {
    "name": "Bootcamp Tracker API",
    "description": "Postman Collection for Bootcamp Tracker Backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Student",
      "description": "Student CRUD endpoints. Requires login as admin or teacher (cookie-based auth).",
      "item": [
        {
          "name": "Create Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Ali Raza\",\n    \"email\": \"ali.raza@example.com\",\n    \"bootcampId\": \"<bootcamp_object_id>\",\n    \"domainId\": \"<domain_object_id>\",\n    \"rollNo\": 101,\n    \"studentStatus\": \"enrolled\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/student",
              "host": ["{{base_url}}"],
              "path": ["student"]
            },
            "description": "Creates a new student. Default password is 'student@123'. Only admin or teacher can access. studentStatus defaults to 'enrolled' if not provided."
          }
        },
        {
          "name": "Get All Students",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/student",
              "host": ["{{base_url}}"],
              "path": ["student"],
              "query": [
                {
                  "key": "bootcampId",
                  "value": "",
                  "description": "Filter by bootcamp (admin only; teachers are auto-scoped to their own bootcamp)",
                  "disabled": true
                },
                {
                  "key": "domainId",
                  "value": "",
                  "description": "Filter by domain",
                  "disabled": true
                },
                {
                  "key": "studentStatus",
                  "value": "",
                  "description": "Filter by status: enrolled | completed | dropout",
                  "disabled": true
                }
              ]
            },
            "description": "Returns all students. Teachers are automatically scoped to their own bootcamp. Admins can optionally filter by bootcampId, domainId, or studentStatus."
          }
        },
        {
          "name": "Get Student By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/student/:id",
              "host": ["{{base_url}}"],
              "path": ["student", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "<student_object_id>",
                  "description": "MongoDB ObjectId of the student"
                }
              ]
            },
            "description": "Fetch a single student by their MongoDB ObjectId."
          }
        },
        {
          "name": "Edit Student",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Ali Raza Updated\",\n    \"email\": \"ali.new@example.com\",\n    \"bootcampId\": \"<bootcamp_object_id>\",\n    \"domainId\": \"<domain_object_id>\",\n    \"rollNo\": 102,\n    \"studentStatus\": \"completed\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/student/:id",
              "host": ["{{base_url}}"],
              "path": ["student", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "<student_object_id>",
                  "description": "MongoDB ObjectId of the student"
                }
              ]
            },
            "description": "Update one or more student fields. Only send the fields you want to change. Email and rollNo are uniqueness-checked."
          }
        },
        {
          "name": "Delete Student",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/student/:id",
              "host": ["{{base_url}}"],
              "path": ["student", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "<student_object_id>",
                  "description": "MongoDB ObjectId of the student"
                }
              ]
            },
            "description": "Permanently deletes a student by their MongoDB ObjectId."
          }
        }
      ]
    },
    {
      "name": "Submission",
      "item": [
        {
          "name": "Submit Assignment",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "assignment",
                  "value": "<assignment_object_id>",
                  "type": "text"
                },
                {
                  "key": "student",
                  "value": "<student_object_id>",
                  "type": "text"
                },
                {
                  "key": "frontendGithubUrl",
                  "value": "https://github.com/example/front",
                  "type": "text"
                },
                {
                  "key": "backendGithubUrl",
                  "value": "https://github.com/example/back",
                  "type": "text"
                },
                {
                  "key": "deployedUrl",
                  "value": "https://example.com",
                  "type": "text"
                },
                {
                  "key": "note",
                  "value": "Assignment note",
                  "type": "text"
                },
                {
                  "key": "referenceFile",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/submission/submit-assignment",
              "host": ["{{base_url}}"],
              "path": ["submission", "submit-assignment"]
